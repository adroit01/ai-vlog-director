# Google Gemini API key (for video intelligence and script synthesis)
GEMINI_API_KEY=

# ElevenLabs API key (optional, for premium cloned digital twin voiceovers)
ELEVENLABS_API_KEY=

# Tavily Search API key (optional, for enhanced web research queries)
TAVILY_API_KEY=

# Ollama local models host endpoint configuration
OLLAMA_HOST=http://localhost:11434

# Langfuse Tracing Configuration (optional, to monitor and debug the agentic flow)
LANGFUSE_PUBLIC_KEY=<public-key>
LANGFUSE_SECRET_KEY=<secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com

F5_TTS_HOST=http://localhost:9000

HF_TOKEN=<HF_ACCES_TOKEN>

# Default LLM models configuration
DEFAULT_ANALYSIS_MODEL=gemini-2.5-flash
DEFAULT_RESEARCH_MODEL=gemini-2.5-flash